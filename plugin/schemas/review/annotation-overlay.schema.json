{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/review/annotation-overlay.v1.json",
  "title": "Review Annotation Overlay",
  "type": "object",
  "required": ["schemaVersion", "subjectId", "reviewRunId", "annotations"],
  "properties": {
    "schemaVersion": {"const": "review.annotation-overlay.v1"},
    "subjectId": {"type": "string", "minLength": 1},
    "reviewRunId": {"type": "string", "minLength": 1},
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["highlightId", "targetType", "targetId", "highlightType", "priority", "evidenceStrength", "reason", "evidenceRefs", "renderHint", "status"],
        "properties": {
          "highlightId": {"type": "string", "minLength": 1},
          "targetType": {"type": "string", "minLength": 1},
          "targetId": {"type": "string", "minLength": 1},
          "highlightType": {"type": "string", "minLength": 1},
          "priority": {"enum": ["critical", "high", "medium", "low"]},
          "evidenceStrength": {"enum": ["confirmed", "supported", "tentative", "unknown"]},
          "reason": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "labels": {"type": "array", "items": {"type": "string"}},
          "actionHint": {"type": "string"},
          "renderHint": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "resolved", "stale", "unresolved_anchor"]},
          "anchor": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
