{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/review/material-review.report.v2.json",
  "title": "Material Review Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviewMode",
    "reviewRunId",
    "examRunId",
    "subjectId",
    "answererType",
    "learnerModelWriteAllowed",
    "learnerModelMutation",
    "coverage",
    "blockerAnalysis",
    "unansweredAnalysis",
    "focuses",
    "questionAnalyses",
    "questionIndex",
    "learningOrder",
    "questionLearningOrder",
    "learningTasks",
    "retestPlans",
    "routes",
    "learnerModel",
    "annotationOverlay",
    "studyGuideMarkdown",
    "studyGuideHtml",
    "examResultIntegrity",
    "examResultMutation",
    "artifactMutation",
    "sourceMutation"
  ],
  "properties": {
    "schemaVersion": {"const": "material-review.report.v2"},
    "reviewMode": {"const": "material"},
    "reviewRunId": {"type": "string", "minLength": 1},
    "examRunId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "answererType": {"enum": ["human", "agent", "model", "unknown"]},
    "learnerModelWriteAllowed": {"const": false},
    "learnerModelMutation": {"const": false},
    "coverage": {"type": "object"},
    "blockerAnalysis": {"type": "object"},
    "unansweredAnalysis": {"type": "object"},
    "focuses": {"type": "array"},
    "questionAnalyses": {"type": "array"},
    "questionIndex": {"type": "array"},
    "learningOrder": {"type": "array"},
    "questionLearningOrder": {"type": "array"},
    "learningTasks": {"type": "array"},
    "retestPlans": {"type": "array"},
    "routes": {"type": "array", "items": {"type": "string"}},
    "learnerModel": {"type": "object"},
    "annotationOverlay": {"type": "object"},
    "studyGuideMarkdown": {"type": "string", "minLength": 1},
    "studyGuideHtml": {"type": "string", "minLength": 1},
    "examResultIntegrity": {"type": "object"},
    "examResultMutation": {"const": false},
    "artifactMutation": {"const": false},
    "sourceMutation": {"const": false}
  },
  "additionalProperties": true
}
