{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/review/material-review.report.v1.json",
  "title": "Material Review Report",
  "type": "object",
  "required": ["schemaVersion", "reviewRunId", "examRunId", "subjectId", "answererType", "learnerModelWriteAllowed", "counts", "blockers", "annotations", "studyGuideMarkdown", "routes", "examResultMutation"],
  "properties": {
    "schemaVersion": {"const": "material-review.report.v1"},
    "reviewRunId": {"type": "string", "minLength": 1},
    "examRunId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "answererType": {"enum": ["human", "agent", "model", "unknown"]},
    "learnerModelWriteAllowed": {"type": "boolean"},
    "counts": {"type": "object"},
    "blockers": {"type": "array"},
    "annotations": {"type": "array"},
    "studyGuideMarkdown": {"type": "string"},
    "routes": {"type": "array", "items": {"type": "string"}},
    "examResultMutation": {"const": false}
  },
  "additionalProperties": true
}
