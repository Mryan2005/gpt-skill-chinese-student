{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-plugins.org/schemas/learner/question-mastery.v1.json",
  "title": "Local Learner Question Mastery",
  "type": "object",
  "required": ["subjectId", "learningEpoch", "updatedAt", "questions"],
  "properties": {
    "subjectId": {"type": "string", "minLength": 1},
    "learningEpoch": {"type": "integer", "minimum": 1},
    "updatedAt": {"type": "string", "minLength": 1},
    "questions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidenceIds", "updatedAt", "history"],
        "properties": {
          "status": {"enum": ["unknown", "needs_diagnosis", "weak", "developing", "proficient", "verified"]},
          "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "updatedAt": {"type": "string", "minLength": 1},
          "history": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
